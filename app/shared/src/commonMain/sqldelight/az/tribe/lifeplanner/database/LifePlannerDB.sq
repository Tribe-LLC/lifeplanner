selectLifeLogsInRange:
SELECT * FROM LifeLogEntity WHERE is_deleted = 0 AND date >= ? AND date <= ? ORDER BY occurredAt DESC;

selectRecentLifeLogs:
SELECT * FROM LifeLogEntity WHERE is_deleted = 0 AND status = 'done' ORDER BY occurredAt DESC LIMIT ?;

selectLifeLogByExternalId:
SELECT * FROM LifeLogEntity WHERE externalId = ? LIMIT 1;

selectLifeLogsByTrip:
SELECT * FROM LifeLogEntity WHERE is_deleted = 0 AND tripId = ? ORDER BY occurredAt DESC;

selectAllBudgets:
SELECT * FROM BudgetEntity WHERE is_deleted = 0 ORDER BY createdAt;

selectAllTrips:
SELECT * FROM TripEntity WHERE is_deleted = 0 ORDER BY startDate;

selectTripItems:
SELECT * FROM TripItemEntity WHERE is_deleted = 0 AND tripId = ? ORDER BY kind, date, sortOrder, createdAt;
