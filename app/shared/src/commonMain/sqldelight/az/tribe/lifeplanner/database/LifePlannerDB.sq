-- ============== Upsert From Sync Queries ==============

upsertGoalFromSync:
INSERT OR REPLACE INTO GoalEntity(id, category, title, description, status, timeline, dueDate, progress, notes, createdAt, completionRate, isArchived, aiReasoning, valueId, wheelArea, predictedDueDate, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertMilestoneFromSync:
INSERT OR REPLACE INTO MilestoneEntity(id, goalId, title, isCompleted, dueDate, estimatedEffort, createdAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

