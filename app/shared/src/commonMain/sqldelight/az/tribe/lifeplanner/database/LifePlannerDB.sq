purgeDeletedUserSituations:
DELETE FROM UserSituationEntity WHERE is_deleted = 1;

deleteAllUserSituations:
DELETE FROM UserSituationEntity;

observeUserSituation:
SELECT * FROM UserSituationEntity WHERE is_deleted = 0 LIMIT 1;

-- CachedPersona (bridge from TribeBot personas_cache)
CREATE TABLE IF NOT EXISTS CachedPersonaEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    style TEXT,
    image_url TEXT,
    is_active INTEGER NOT NULL DEFAULT 1,
    fetched_at TEXT NOT NULL,
    title TEXT NOT NULL DEFAULT 'Coach',
    category TEXT NOT NULL DEFAULT 'WELLBEING',
    emoji TEXT NOT NULL DEFAULT '✨',
    greeting TEXT,
    specialties TEXT,
    personality TEXT,
    avatar_bg_color TEXT NOT NULL DEFAULT '#6366F1',
    avatar_accent_color TEXT NOT NULL DEFAULT '#818CF8',
    avatar_icon_name TEXT NOT NULL DEFAULT 'star',
    bio TEXT,
    fun_fact TEXT,
    xp_to_unlock INTEGER NOT NULL DEFAULT 0,
    is_default_unlocked INTEGER NOT NULL DEFAULT 1,
    timezone TEXT,
    city TEXT,
    country_flag TEXT,
    slug TEXT,
    avatar_url TEXT
);

upsertCachedPersona:
INSERT OR REPLACE INTO CachedPersonaEntity(
    id, name, description, style, image_url, is_active, fetched_at,
    title, category, emoji, greeting, specialties, personality,
    avatar_bg_color, avatar_accent_color, avatar_icon_name,
    bio, fun_fact, xp_to_unlock, is_default_unlocked,
    timezone, city, country_flag, slug, avatar_url
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllCachedPersonas:
SELECT * FROM CachedPersonaEntity WHERE is_active = 1;

deleteAllCachedPersonas:
DELETE FROM CachedPersonaEntity;

-- ============== LifeValueEntity (Pillar 1: the "reason" layer above Goal) ==============
-- `order` is a SQL reserved word, so the column is named `sortOrder`.
CREATE TABLE LifeValueEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    isActive INTEGER NOT NULL DEFAULT 1,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

CREATE INDEX IF NOT EXISTS idx_life_value_active ON LifeValueEntity(isActive, is_deleted);

selectAllLifeValues:
SELECT * FROM LifeValueEntity WHERE is_deleted = 0 ORDER BY sortOrder ASC;

selectActiveLifeValues:
SELECT * FROM LifeValueEntity WHERE is_deleted = 0 AND isActive = 1 ORDER BY sortOrder ASC;

selectLifeValueById:
SELECT * FROM LifeValueEntity WHERE id = ?;

insertLifeValue:
INSERT OR REPLACE INTO LifeValueEntity(id, title, description, isActive, sortOrder, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateLifeValue:
UPDATE LifeValueEntity
SET title = ?, description = ?, isActive = ?, sortOrder = ?,
    sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
WHERE id = ?;

softDeleteLifeValue:
UPDATE LifeValueEntity SET is_deleted = 1, sync_updated_at = ? WHERE id = ?;

deleteAllLifeValues:
DELETE FROM LifeValueEntity;

-- LifeValue sync queries
getUnsyncedLifeValues:
SELECT * FROM LifeValueEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedLifeValues:
SELECT * FROM LifeValueEntity WHERE is_deleted = 1;

markLifeValueSynced:
UPDATE LifeValueEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedLifeValues:
DELETE FROM LifeValueEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertLifeValueFromSync:
INSERT OR REPLACE INTO LifeValueEntity(id, title, description, isActive, sortOrder, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ============== KnowledgeReadEntity (Learn hub: which lessons the user has read) ==============
-- `id` is the KnowledgeBit id (e.g. 'tip_2min_rule'). `readAt` is an ISO-8601 timestamp.
CREATE TABLE KnowledgeReadEntity (
    id TEXT NOT NULL PRIMARY KEY,
    readAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

selectAllKnowledgeReads:
SELECT * FROM KnowledgeReadEntity WHERE is_deleted = 0 ORDER BY readAt DESC;

selectKnowledgeReadById:
SELECT * FROM KnowledgeReadEntity WHERE id = ?;

markKnowledgeRead:
INSERT OR REPLACE INTO KnowledgeReadEntity(id, readAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0, 0, NULL);

softDeleteKnowledgeRead:
UPDATE KnowledgeReadEntity SET is_deleted = 1, sync_updated_at = ? WHERE id = ?;

deleteAllKnowledgeReads:
DELETE FROM KnowledgeReadEntity;

-- KnowledgeRead sync queries
getUnsyncedKnowledgeReads:
SELECT * FROM KnowledgeReadEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedKnowledgeReads:
SELECT * FROM KnowledgeReadEntity WHERE is_deleted = 1;

markKnowledgeReadSynced:
UPDATE KnowledgeReadEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedKnowledgeReads:
DELETE FROM KnowledgeReadEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertKnowledgeReadFromSync:
INSERT OR REPLACE INTO KnowledgeReadEntity(id, readAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?);

-- ============== Learn content cache (server-owned, one-way pull from Supabase) ==============
-- Lesson *content* is authored in Supabase and cached here so the Learn map works offline and on
-- the next cold start. Deliberately outside the syncer set: this is not user data, it never gets
-- pushed, and there is nothing to merge. `detail`, `topics` and `lessonIds` hold JSON arrays.
CREATE TABLE KnowledgeLessonEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    emoji TEXT NOT NULL,
    minLevel INTEGER NOT NULL DEFAULT 1,
    readMin INTEGER NOT NULL DEFAULT 2,
    detail TEXT NOT NULL DEFAULT '[]',
    takeaway TEXT NOT NULL DEFAULT '',
    source TEXT,
    topics TEXT NOT NULL DEFAULT '[]',
    sortOrder INTEGER NOT NULL DEFAULT 0,
    fetchedAt TEXT NOT NULL
);

CREATE TABLE KnowledgeCollectionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    subtitle TEXT NOT NULL,
    emoji TEXT NOT NULL,
    lessonIds TEXT NOT NULL DEFAULT '[]',
    sortOrder INTEGER NOT NULL DEFAULT 0,
    fetchedAt TEXT NOT NULL
);

selectAllKnowledgeLessons:
SELECT * FROM KnowledgeLessonEntity ORDER BY sortOrder ASC;

selectAllKnowledgeCollections:
SELECT * FROM KnowledgeCollectionEntity ORDER BY sortOrder ASC;

upsertKnowledgeLesson:
INSERT OR REPLACE INTO KnowledgeLessonEntity(id, title, body, emoji, minLevel, readMin, detail, takeaway, source, topics, sortOrder, fetchedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertKnowledgeCollection:
INSERT OR REPLACE INTO KnowledgeCollectionEntity(id, title, subtitle, emoji, lessonIds, sortOrder, fetchedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteAllKnowledgeLessons:
DELETE FROM KnowledgeLessonEntity;

deleteAllKnowledgeCollections:
DELETE FROM KnowledgeCollectionEntity;

-- ============== DecisionEntity (Pillar 3: decisions as first-class objects) ==============
-- optionsConsidered stored as a newline-delimited string; outcomeQuality as the enum name.
CREATE TABLE DecisionEntity (
    id TEXT NOT NULL PRIMARY KEY,
    question TEXT NOT NULL,
    optionsConsidered TEXT NOT NULL DEFAULT '',
    chosenOption TEXT NOT NULL,
    reasoning TEXT NOT NULL DEFAULT '',
    relatedGoalId TEXT,
    expectedOutcome TEXT NOT NULL DEFAULT '',
    confidence INTEGER NOT NULL DEFAULT 50,
    decidedAt TEXT NOT NULL,
    actualOutcome TEXT,
    outcomeReviewedAt TEXT,
    outcomeQuality TEXT,
    source TEXT NOT NULL DEFAULT 'CHOICE_POINT',
    status TEXT NOT NULL DEFAULT 'CONFIRMED',
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

CREATE INDEX IF NOT EXISTS idx_decision_goal ON DecisionEntity(relatedGoalId);

selectAllDecisions:
SELECT * FROM DecisionEntity WHERE is_deleted = 0 ORDER BY decidedAt DESC;

selectDecisionById:
SELECT * FROM DecisionEntity WHERE id = ?;

selectDecisionsByGoal:
SELECT * FROM DecisionEntity WHERE relatedGoalId = ? AND is_deleted = 0 ORDER BY decidedAt DESC;

insertDecision:
INSERT OR REPLACE INTO DecisionEntity(id, question, optionsConsidered, chosenOption, reasoning, relatedGoalId, expectedOutcome, confidence, decidedAt, actualOutcome, outcomeReviewedAt, outcomeQuality, source, status, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDecision:
UPDATE DecisionEntity
SET question = ?, optionsConsidered = ?, chosenOption = ?, reasoning = ?, relatedGoalId = ?,
    expectedOutcome = ?, confidence = ?, decidedAt = ?, actualOutcome = ?, outcomeReviewedAt = ?, outcomeQuality = ?, status = ?,
    sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
WHERE id = ?;

softDeleteDecision:
UPDATE DecisionEntity SET is_deleted = 1, sync_updated_at = ? WHERE id = ?;

deleteAllDecisions:
DELETE FROM DecisionEntity;

-- Decision sync queries
getUnsyncedDecisions:
SELECT * FROM DecisionEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedDecisions:
SELECT * FROM DecisionEntity WHERE is_deleted = 1;

markDecisionSynced:
UPDATE DecisionEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedDecisions:
DELETE FROM DecisionEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertDecisionFromSync:
INSERT OR REPLACE INTO DecisionEntity(id, question, optionsConsidered, chosenOption, reasoning, relatedGoalId, expectedOutcome, confidence, decidedAt, actualOutcome, outcomeReviewedAt, outcomeQuality, source, status, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ============== IdentityStatementEntity (Pillar 5: "I'm becoming someone who…") ==============
-- Identity layer above XP/levels, tied to a LifeValue (Pillar 1) via valueId (soft ref).
CREATE TABLE IdentityStatementEntity (
    id TEXT NOT NULL PRIMARY KEY,
    statement TEXT NOT NULL,
    valueId TEXT,
    isActive INTEGER NOT NULL DEFAULT 1,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

CREATE INDEX IF NOT EXISTS idx_identity_statement_value ON IdentityStatementEntity(valueId);

selectAllIdentityStatements:
SELECT * FROM IdentityStatementEntity WHERE is_deleted = 0 ORDER BY sortOrder ASC;

selectIdentityStatementById:
SELECT * FROM IdentityStatementEntity WHERE id = ?;

selectIdentityStatementsByValue:
SELECT * FROM IdentityStatementEntity WHERE valueId = ? AND is_deleted = 0 ORDER BY sortOrder ASC;

insertIdentityStatement:
INSERT OR REPLACE INTO IdentityStatementEntity(id, statement, valueId, isActive, sortOrder, createdAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateIdentityStatement:
UPDATE IdentityStatementEntity
SET statement = ?, valueId = ?, isActive = ?, sortOrder = ?, createdAt = ?,
    sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
WHERE id = ?;

softDeleteIdentityStatement:
UPDATE IdentityStatementEntity SET is_deleted = 1, sync_updated_at = ? WHERE id = ?;

deleteAllIdentityStatements:
DELETE FROM IdentityStatementEntity;

-- IdentityStatement sync queries
getUnsyncedIdentityStatements:
SELECT * FROM IdentityStatementEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedIdentityStatements:
SELECT * FROM IdentityStatementEntity WHERE is_deleted = 1;

markIdentityStatementSynced:
UPDATE IdentityStatementEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedIdentityStatements:
DELETE FROM IdentityStatementEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertIdentityStatementFromSync:
INSERT OR REPLACE INTO IdentityStatementEntity(id, statement, valueId, isActive, sortOrder, createdAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ============== DecisionProfileEntity (Pillar 7: the user's six "wiring" dials) ==============
-- One row per user. Kevin Mitchell's six Innate decision-making dials (Fig 6.2), each with a
-- value (0..1, neutral 0.5), an inference confidence (0..1), and a sample size. Inferred from
-- behaviour by the TuningInferenceEngine; no dial value is "good" or "bad".
CREATE TABLE DecisionProfileEntity (
    id TEXT NOT NULL PRIMARY KEY,
    confidenceThresholdValue REAL NOT NULL DEFAULT 0.5,
    confidenceThresholdConfidence REAL NOT NULL DEFAULT 0.0,
    confidenceThresholdSamples INTEGER NOT NULL DEFAULT 0,
    noveltySalienceValue REAL NOT NULL DEFAULT 0.5,
    noveltySalienceConfidence REAL NOT NULL DEFAULT 0.0,
    noveltySalienceSamples INTEGER NOT NULL DEFAULT 0,
    delayDiscountingValue REAL NOT NULL DEFAULT 0.5,
    delayDiscountingConfidence REAL NOT NULL DEFAULT 0.0,
    delayDiscountingSamples INTEGER NOT NULL DEFAULT 0,
    punishmentSensitivityValue REAL NOT NULL DEFAULT 0.5,
    punishmentSensitivityConfidence REAL NOT NULL DEFAULT 0.0,
    punishmentSensitivitySamples INTEGER NOT NULL DEFAULT 0,
    rewardSensitivityValue REAL NOT NULL DEFAULT 0.5,
    rewardSensitivityConfidence REAL NOT NULL DEFAULT 0.0,
    rewardSensitivitySamples INTEGER NOT NULL DEFAULT 0,
    riskAversionValue REAL NOT NULL DEFAULT 0.5,
    riskAversionConfidence REAL NOT NULL DEFAULT 0.0,
    riskAversionSamples INTEGER NOT NULL DEFAULT 0,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

selectDecisionProfile:
SELECT * FROM DecisionProfileEntity WHERE is_deleted = 0 LIMIT 1;

upsertDecisionProfile:
INSERT OR REPLACE INTO DecisionProfileEntity(id, confidenceThresholdValue, confidenceThresholdConfidence, confidenceThresholdSamples, noveltySalienceValue, noveltySalienceConfidence, noveltySalienceSamples, delayDiscountingValue, delayDiscountingConfidence, delayDiscountingSamples, punishmentSensitivityValue, punishmentSensitivityConfidence, punishmentSensitivitySamples, rewardSensitivityValue, rewardSensitivityConfidence, rewardSensitivitySamples, riskAversionValue, riskAversionConfidence, riskAversionSamples, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllDecisionProfiles:
DELETE FROM DecisionProfileEntity;

-- DecisionProfile sync queries
getUnsyncedDecisionProfiles:
SELECT * FROM DecisionProfileEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedDecisionProfiles:
SELECT * FROM DecisionProfileEntity WHERE is_deleted = 1;

markDecisionProfileSynced:
UPDATE DecisionProfileEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedDecisionProfiles:
DELETE FROM DecisionProfileEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertDecisionProfileFromSync:
INSERT OR REPLACE INTO DecisionProfileEntity(id, confidenceThresholdValue, confidenceThresholdConfidence, confidenceThresholdSamples, noveltySalienceValue, noveltySalienceConfidence, noveltySalienceSamples, delayDiscountingValue, delayDiscountingConfidence, delayDiscountingSamples, punishmentSensitivityValue, punishmentSensitivityConfidence, punishmentSensitivitySamples, rewardSensitivityValue, rewardSensitivityConfidence, rewardSensitivitySamples, riskAversionValue, riskAversionConfidence, riskAversionSamples, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ============== Wheel of Life ==============
-- Only the scores the user set themselves. Predictions are recomputed from live signals on every
-- read (see WheelScorePredictor), so persisting them would just create a staleness problem: a
-- cached "Physical 7" would outlive the week of steps that produced it. One row per area, keyed by
-- the WheelArea enum name.
CREATE TABLE WheelScoreEntity (
    id TEXT NOT NULL PRIMARY KEY,
    score REAL NOT NULL,
    assessedAt TEXT NOT NULL,
    note TEXT,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

selectAllWheelScores:
SELECT * FROM WheelScoreEntity WHERE is_deleted = 0;

selectWheelScoreById:
SELECT * FROM WheelScoreEntity WHERE id = ?;

setWheelScore:
INSERT OR REPLACE INTO WheelScoreEntity(id, score, assessedAt, note, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0, 0, NULL);

clearWheelScore:
UPDATE WheelScoreEntity SET is_deleted = 1, sync_updated_at = ? WHERE id = ?;

deleteAllWheelScores:
DELETE FROM WheelScoreEntity;

-- WheelScore sync queries
getUnsyncedWheelScores:
SELECT * FROM WheelScoreEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedWheelScores:
SELECT * FROM WheelScoreEntity WHERE is_deleted = 1;

markWheelScoreSynced:
UPDATE WheelScoreEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedWheelScores:
DELETE FROM WheelScoreEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertWheelScoreFromSync:
INSERT OR REPLACE INTO WheelScoreEntity(id, score, assessedAt, note, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);


-- ============== Wheel of Life snapshots ==============
-- One row per day, keyed by date, holding the whole wheel as JSON.
-- Snapshots exist because a past wheel cannot be recomputed: predictions read trailing windows (a
-- week of steps, a month of mood), so the evidence behind an old score has aged out by the time you
-- want to compare against it. Keyed by date so writing twice in a day updates that day rather than
-- accumulating duplicates, which makes the capture-on-open path trivially idempotent.
CREATE TABLE WheelSnapshotEntity (
    id TEXT NOT NULL PRIMARY KEY,
    scores TEXT NOT NULL,
    capturedAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

selectAllWheelSnapshots:
SELECT * FROM WheelSnapshotEntity WHERE is_deleted = 0 ORDER BY id DESC;

selectWheelSnapshotById:
SELECT * FROM WheelSnapshotEntity WHERE id = ?;

-- The nearest snapshot at or before a date: someone who did not open the app on the exact day
-- should still get a comparison rather than nothing.
selectWheelSnapshotOnOrBefore:
SELECT * FROM WheelSnapshotEntity WHERE is_deleted = 0 AND id <= ? ORDER BY id DESC LIMIT 1;

putWheelSnapshot:
INSERT OR REPLACE INTO WheelSnapshotEntity(id, scores, capturedAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0, 0, NULL);

deleteAllWheelSnapshots:
DELETE FROM WheelSnapshotEntity;

-- WheelSnapshot sync queries
getUnsyncedWheelSnapshots:
SELECT * FROM WheelSnapshotEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedWheelSnapshots:
SELECT * FROM WheelSnapshotEntity WHERE is_deleted = 1;

markWheelSnapshotSynced:
UPDATE WheelSnapshotEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedWheelSnapshots:
DELETE FROM WheelSnapshotEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertWheelSnapshotFromSync:
INSERT OR REPLACE INTO WheelSnapshotEntity(id, scores, capturedAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- ============== v4 life areas (schema 43) ==============
-- Logs, budgets and trips. Same soft-delete sync columns as every synced table.

CREATE TABLE IF NOT EXISTS LifeLogEntity (
    id TEXT NOT NULL PRIMARY KEY,
    area TEXT NOT NULL,
    kind TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'done',
    title TEXT NOT NULL,
    amount REAL,
    currency TEXT,
    category TEXT,
    quantity REAL,
    unit TEXT,
    durationMin INTEGER,
    occurredAt TEXT NOT NULL,
    date TEXT NOT NULL,
    source TEXT NOT NULL DEFAULT 'manual',
    externalId TEXT,
    tripId TEXT,
    notes TEXT,
    createdAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);
CREATE INDEX IF NOT EXISTS idx_life_log_date ON LifeLogEntity(date);
CREATE INDEX IF NOT EXISTS idx_life_log_area ON LifeLogEntity(area);
CREATE TABLE IF NOT EXISTS BudgetEntity (
    id TEXT NOT NULL PRIMARY KEY,
    area TEXT NOT NULL,
    metric TEXT NOT NULL,
    category TEXT,
    amount REAL NOT NULL,
    currency TEXT,
    period TEXT NOT NULL,
    tripId TEXT,
    createdAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);
CREATE TABLE IF NOT EXISTS TripEntity (
    id TEXT NOT NULL PRIMARY KEY,
    destination TEXT NOT NULL,
    latitude REAL,
    longitude REAL,
    startDate TEXT NOT NULL,
    endDate TEXT NOT NULL,
    budget REAL,
    currency TEXT,
    travelMode INTEGER NOT NULL DEFAULT 1,
    notes TEXT,
    createdAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);
CREATE TABLE IF NOT EXISTS TripItemEntity (
    id TEXT NOT NULL PRIMARY KEY,
    tripId TEXT NOT NULL,
    kind TEXT NOT NULL,
    title TEXT NOT NULL,
    notes TEXT,
    date TEXT,
    isDone INTEGER NOT NULL DEFAULT 0,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);
CREATE INDEX IF NOT EXISTS idx_trip_item_trip ON TripItemEntity(tripId);

-- LifeLog queries
selectLifeLogById:
SELECT * FROM LifeLogEntity WHERE id = ?;

saveLifeLog:
INSERT OR REPLACE INTO LifeLogEntity(id, area, kind, status, title, amount, currency, category, quantity, unit, durationMin, occurredAt, date, source, externalId, tripId, notes, createdAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, strftime('%Y-%m-%dT%H:%M:%fZ', 'now'), 0,
    COALESCE((SELECT sync_version FROM LifeLogEntity WHERE id = ?), 0),
    (SELECT last_synced_at FROM LifeLogEntity WHERE id = ?));

softDeleteLifeLog:
UPDATE LifeLogEntity SET is_deleted = 1, sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now') WHERE id = ?;

deleteAllLifeLogs:
DELETE FROM LifeLogEntity;

getUnsyncedLifeLogs:
SELECT * FROM LifeLogEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedLifeLogs:
SELECT * FROM LifeLogEntity WHERE is_deleted = 1;

markLifeLogSynced:
UPDATE LifeLogEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedLifeLogs:
DELETE FROM LifeLogEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertLifeLogFromSync:
INSERT OR REPLACE INTO LifeLogEntity(id, area, kind, status, title, amount, currency, category, quantity, unit, durationMin, occurredAt, date, source, externalId, tripId, notes, createdAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

