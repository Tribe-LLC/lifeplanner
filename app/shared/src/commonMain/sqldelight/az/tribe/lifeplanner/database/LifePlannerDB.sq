-- Coach Persona Override Table for customizing built-in coach behavior
CREATE TABLE IF NOT EXISTS CoachPersonaOverrideEntity (
    coachId TEXT PRIMARY KEY NOT NULL,
    userPersona TEXT NOT NULL DEFAULT '',
    updatedAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

getCoachPersonaOverride:
SELECT * FROM CoachPersonaOverrideEntity WHERE coachId = ? AND is_deleted = 0;

upsertCoachPersonaOverride:
INSERT OR REPLACE INTO CoachPersonaOverrideEntity(coachId, userPersona, updatedAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, 0, 0, NULL);

deleteCoachPersonaOverride:
UPDATE CoachPersonaOverrideEntity SET is_deleted = 1, sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now') WHERE coachId = ?;

-- CoachPersonaOverride sync queries
getUnsyncedCoachPersonaOverrides:
SELECT * FROM CoachPersonaOverrideEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedCoachPersonaOverrides:
SELECT * FROM CoachPersonaOverrideEntity WHERE is_deleted = 1;

markCoachPersonaOverrideSynced:
UPDATE CoachPersonaOverrideEntity SET last_synced_at = ? WHERE coachId = ?;

purgeDeletedCoachPersonaOverrides:
DELETE FROM CoachPersonaOverrideEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertCoachPersonaOverrideFromSync:
INSERT OR REPLACE INTO CoachPersonaOverrideEntity(coachId, userPersona, updatedAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- ===== Beginner Objectives =====
CREATE TABLE IF NOT EXISTS BeginnerObjectiveEntity (
    id TEXT PRIMARY KEY NOT NULL,
    objectiveType TEXT NOT NULL,
    isCompleted INTEGER NOT NULL DEFAULT 0,
    completedAt TEXT,
    xpAwarded INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

insertBeginnerObjective:
INSERT OR REPLACE INTO BeginnerObjectiveEntity(id, objectiveType, isCompleted, completedAt, xpAwarded, createdAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllBeginnerObjectives:
SELECT * FROM BeginnerObjectiveEntity WHERE is_deleted = 0;

getBeginnerObjectiveByType:
SELECT * FROM BeginnerObjectiveEntity WHERE objectiveType = ? AND is_deleted = 0 LIMIT 1;

deduplicateBeginnerObjectives:
DELETE FROM BeginnerObjectiveEntity
WHERE id NOT IN (
    SELECT MIN(id) FROM BeginnerObjectiveEntity GROUP BY objectiveType
);

getCompletedBeginnerObjectivesCount:
SELECT COUNT(*) FROM BeginnerObjectiveEntity WHERE isCompleted = 1 AND is_deleted = 0;

completeBeginnerObjective:
UPDATE BeginnerObjectiveEntity
SET isCompleted = 1, completedAt = ?, xpAwarded = ?, sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
WHERE objectiveType = ? AND isCompleted = 0;

uncompleteBeginnerObjective:
UPDATE BeginnerObjectiveEntity
SET isCompleted = 0, completedAt = NULL, xpAwarded = 0, sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
WHERE objectiveType = ? AND isCompleted = 1;

deleteAllBeginnerObjectives:
DELETE FROM BeginnerObjectiveEntity;

-- Beginner Objectives sync queries
getUnsyncedBeginnerObjectives:
SELECT * FROM BeginnerObjectiveEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedBeginnerObjectives:
SELECT * FROM BeginnerObjectiveEntity WHERE is_deleted = 1;

markBeginnerObjectiveSynced:
UPDATE BeginnerObjectiveEntity SET last_synced_at = ? WHERE id = ?;

purgeDeletedBeginnerObjectives:
DELETE FROM BeginnerObjectiveEntity WHERE is_deleted = 1 AND last_synced_at IS NOT NULL;

upsertBeginnerObjectiveFromSync:
INSERT OR REPLACE INTO BeginnerObjectiveEntity(id, objectiveType, isCompleted, completedAt, xpAwarded, createdAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- ===== Health Metrics =====
CREATE TABLE IF NOT EXISTS HealthMetricEntity (
    id TEXT PRIMARY KEY NOT NULL,
    metricType TEXT NOT NULL,
    value_ REAL NOT NULL,
    unit TEXT NOT NULL,
    date TEXT NOT NULL,
    source TEXT NOT NULL DEFAULT 'PLATFORM',
    recordedAt TEXT NOT NULL,
    createdAt TEXT NOT NULL,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

CREATE INDEX IF NOT EXISTS idx_health_metric_type ON HealthMetricEntity(metricType);
CREATE INDEX IF NOT EXISTS idx_health_metric_date ON HealthMetricEntity(date);

insertHealthMetric:
INSERT OR REPLACE INTO HealthMetricEntity(id, metricType, value_, unit, date, source, recordedAt, createdAt, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, datetime('now'), 0, 0, NULL);

observeHealthMetricsByType:
SELECT * FROM HealthMetricEntity WHERE metricType = ? AND is_deleted = 0 ORDER BY date DESC;

getHealthMetricsByTypeAndDateRange:
SELECT * FROM HealthMetricEntity WHERE metricType = ? AND date >= ? AND date <= ? AND is_deleted = 0 ORDER BY date ASC;

getLatestHealthMetric:
SELECT * FROM HealthMetricEntity WHERE metricType = ? AND is_deleted = 0 ORDER BY date DESC LIMIT 1;

deleteHealthMetric:
UPDATE HealthMetricEntity SET is_deleted = 1, sync_updated_at = datetime('now') WHERE id = ?;

-- ===== Abilities =====
CREATE TABLE IF NOT EXISTS AbilityEntity (
    id TEXT PRIMARY KEY NOT NULL,
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    iconEmoji TEXT NOT NULL DEFAULT '⚡',
    totalXp INTEGER NOT NULL DEFAULT 0,
    currentLevel INTEGER NOT NULL DEFAULT 1,
    isActive INTEGER NOT NULL DEFAULT 1,
    createdAt TEXT NOT NULL,
    lastActivityDate TEXT,
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

CREATE TABLE IF NOT EXISTS AbilityHabitLinkEntity (
    id TEXT PRIMARY KEY NOT NULL,
    abilityId TEXT NOT NULL,
    habitId TEXT NOT NULL,
    xpWeight REAL NOT NULL DEFAULT 1.0,
    createdAt TEXT NOT NULL,
    FOREIGN KEY (abilityId) REFERENCES AbilityEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (habitId) REFERENCES HabitEntity(id) ON DELETE CASCADE
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_ability_habit_unique ON AbilityHabitLinkEntity(abilityId, habitId);

-- Ability queries
insertAbility:
INSERT OR REPLACE INTO AbilityEntity(id, title, description, iconEmoji, totalXp, currentLevel, isActive, createdAt, lastActivityDate, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getAllAbilities:
SELECT * FROM AbilityEntity WHERE isActive = 1 AND is_deleted = 0 ORDER BY currentLevel DESC, totalXp DESC;

getAbilityById:
SELECT * FROM AbilityEntity WHERE id = ? AND is_deleted = 0;

updateAbility:
UPDATE AbilityEntity
SET title = ?, description = ?, iconEmoji = ?, sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
WHERE id = ?;

updateAbilityXpAndLevel:
UPDATE AbilityEntity
SET totalXp = ?, currentLevel = ?, lastActivityDate = ?, sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now')
WHERE id = ?;

deleteAbility:
UPDATE AbilityEntity SET is_deleted = 1, sync_updated_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now') WHERE id = ?;

-- AbilityHabitLink queries
insertAbilityHabitLink:
INSERT OR IGNORE INTO AbilityHabitLinkEntity(id, abilityId, habitId, xpWeight, createdAt)
VALUES (?, ?, ?, ?, ?);

getLinksForAbility:
SELECT * FROM AbilityHabitLinkEntity WHERE abilityId = ?;

getLinksForHabit:
SELECT * FROM AbilityHabitLinkEntity WHERE habitId = ?;

deleteAbilityHabitLink:
DELETE FROM AbilityHabitLinkEntity WHERE abilityId = ? AND habitId = ?;

deleteAllLinksForAbility:
DELETE FROM AbilityHabitLinkEntity WHERE abilityId = ?;

-- Clear all
deleteAllAbilities:
DELETE FROM AbilityEntity;

deleteAllAbilityHabitLinks:
DELETE FROM AbilityHabitLinkEntity;

-- ===== Ability-Goal Links =====
CREATE TABLE IF NOT EXISTS AbilityGoalLinkEntity (
    id TEXT PRIMARY KEY NOT NULL,
    abilityId TEXT NOT NULL,
    goalId TEXT NOT NULL,
    createdAt TEXT NOT NULL,
    FOREIGN KEY (abilityId) REFERENCES AbilityEntity(id) ON DELETE CASCADE,
    FOREIGN KEY (goalId) REFERENCES GoalEntity(id) ON DELETE CASCADE
);
CREATE UNIQUE INDEX IF NOT EXISTS idx_ability_goal_unique ON AbilityGoalLinkEntity(abilityId, goalId);

insertAbilityGoalLink:
INSERT OR IGNORE INTO AbilityGoalLinkEntity(id, abilityId, goalId, createdAt)
VALUES (?, ?, ?, ?);

getGoalLinksForAbility:
SELECT * FROM AbilityGoalLinkEntity WHERE abilityId = ?;

getAbilityLinksForGoal:
SELECT * FROM AbilityGoalLinkEntity WHERE goalId = ?;

deleteAbilityGoalLink:
DELETE FROM AbilityGoalLinkEntity WHERE abilityId = ? AND goalId = ?;

deleteAllGoalLinksForAbility:
DELETE FROM AbilityGoalLinkEntity WHERE abilityId = ?;

deleteAllAbilityGoalLinks:
DELETE FROM AbilityGoalLinkEntity;

-- ==================== DAY RECAP ====================

CREATE TABLE IF NOT EXISTS DayRecapEntity (
    date TEXT PRIMARY KEY NOT NULL,
    recap TEXT NOT NULL,
    generatedAt TEXT NOT NULL
);

getDayRecap:
SELECT * FROM DayRecapEntity WHERE date = ?;

insertOrReplaceDayRecap:
INSERT OR REPLACE INTO DayRecapEntity(date, recap, generatedAt) VALUES(?, ?, ?);

deleteAllDayRecaps:
DELETE FROM DayRecapEntity;

-- ==================== USER SITUATION ====================

CREATE TABLE IF NOT EXISTS UserSituationEntity (
    id TEXT PRIMARY KEY NOT NULL,
    meta_json TEXT NOT NULL DEFAULT '{}',
    career_json TEXT NOT NULL DEFAULT '{}',
    money_json TEXT NOT NULL DEFAULT '{}',
    body_json TEXT NOT NULL DEFAULT '{}',
    people_json TEXT NOT NULL DEFAULT '{}',
    purpose_json TEXT NOT NULL DEFAULT '{}',
    last_updated_by TEXT NOT NULL DEFAULT '',
    sync_updated_at TEXT,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    sync_version INTEGER NOT NULL DEFAULT 0,
    last_synced_at TEXT
);

getUserSituation:
SELECT * FROM UserSituationEntity WHERE is_deleted = 0 LIMIT 1;

getUserSituationById:
SELECT * FROM UserSituationEntity WHERE id = ?;

upsertUserSituation:
INSERT OR REPLACE INTO UserSituationEntity(id, meta_json, career_json, money_json, body_json, people_json, purpose_json, last_updated_by, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

upsertUserSituationFromSync:
INSERT OR REPLACE INTO UserSituationEntity(id, meta_json, career_json, money_json, body_json, people_json, purpose_json, last_updated_by, sync_updated_at, is_deleted, sync_version, last_synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markUserSituationSynced:
UPDATE UserSituationEntity SET last_synced_at = ? WHERE id = ?;

getUnsyncedUserSituations:
SELECT * FROM UserSituationEntity WHERE (last_synced_at IS NULL OR sync_updated_at > last_synced_at) AND is_deleted = 0;

getDeletedUserSituations:
